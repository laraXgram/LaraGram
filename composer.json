{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laraxgram/laragram",
    "type": "project",
    "description": "LaraGram, an advanced framework for Telegram Bot development.",
    "keywords": [
        "laragram",
        "framework",
        "laraquest",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laraxgram/core": "^4.5",
        "laraxgram/watchdog": "^1.3",
        "laraxgram/tempora": "^1",
        "laraxgram/probe": "^0.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php laragram config:clear",
            "@php laragram clear-compiled",
            "@php laragram package:discover --ansi",
            "@php -r \"is_file('vendor/laraxgram/mtproto/bin/compile-tl.php') && ! is_dir('vendor/laraxgram/mtproto/src/Generated') && passthru(escapeshellarg(PHP_BINARY).' vendor/laraxgram/mtproto/bin/compile-tl.php');\""
        ],
        "post-install-cmd": [
            "@php vendor/laraxgram/laraquest/bin/parse-telegram-api.php"
        ],
        "post-update-cmd": [
            "@php vendor/laraxgram/laraquest/bin/parse-telegram-api.php",
            "@php laragram vendor:publish --tag=laragram-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php laragram key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php laragram migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php laragram dev"
        ]
    },
    "extra": {
        "laragram": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
